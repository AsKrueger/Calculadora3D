# Configuración de base de datos para Docker Compose
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgrespassword

# Configuración de Seguridad JWT
# Obligatorio. Clave en Base64 de al menos 256 bits (32 bytes) para HS256.
# Genera la tuya con: openssl rand -base64 32
# El valor de abajo es solo para desarrollo local: no lo uses en produccion.
JWT_SECRET=bG9jYWwtZGV2LW9ubHktY2hhbmdlLW1lLTMyLWJ5dGVzLWtleSEh
JWT_EXPIRATION=3600000

# Configuración del Cliente Externo ESIOS
ESIOS_API_TOKEN=tu_token_personal_de_esios_aqui
